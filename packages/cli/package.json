{
  "name": "@logic-sdk/cli",
  "version": "0.5.0",
  "description": "The logic-sdk CLI: list, show, graph and check an app. Run it with `npx logic-sdk`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fprl/logic-sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/fprl/logic-sdk#readme",
  "bugs": {
    "url": "https://github.com/fprl/logic-sdk/issues"
  },
  "author": {
    "name": "Franco Romano Losada",
    "url": "https://github.com/fprl"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "bun run build && bun test"
  },
  "dependencies": {
    "@stricli/core": "^1.3.0",
    "jiti": "^2.7.0",
    "oxc-parser": "^0.159.0",
    "oxc-resolver": "^11.24.2"
  },
  "devDependencies": {
    "logic-sdk": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6"
  },
  "peerDependencies": {
    "logic-sdk": ">=0.5.0 <0.6.0"
  }
}
