{
  "name": "logic-sdk",
  "version": "0.5.0",
  "description": "Queries, mutations, actions and events for TypeScript apps. Transactions, after-commit events and scopes, on any runtime.",
  "keywords": [
    "actions",
    "agents",
    "ai-agents",
    "ai-sdk",
    "business-logic",
    "cloudflare-workers",
    "drizzle",
    "events",
    "mutations",
    "queries",
    "tools",
    "transactions",
    "typescript"
  ],
  "author": {
    "name": "Franco Romano Losada",
    "url": "https://github.com/fprl"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fprl/logic-sdk.git",
    "directory": "packages/logic-sdk"
  },
  "homepage": "https://github.com/fprl/logic-sdk#readme",
  "bugs": {
    "url": "https://github.com/fprl/logic-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "logic-sdk": "bin/logic-sdk.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "bun test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./orpc": {
      "types": "./dist/orpc.d.ts",
      "default": "./dist/orpc.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "@orpc/server": ">=2.0.0-beta.51 <3",
    "drizzle-orm": ">=1.0.0-rc.5 <2",
    "ai": ">=7 <8",
    "@logic-sdk/cli": ">=0.5.0 <0.6.0"
  },
  "peerDependenciesMeta": {
    "@orpc/server": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@logic-sdk/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@orpc/server": "2.0.0-beta.51",
    "@types/bun": "^1.4.4",
    "ai": "^7.0.177",
    "drizzle-orm": "1.0.0-rc.6",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  }
}
